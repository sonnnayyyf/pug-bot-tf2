[Unit]
Description=TF2 PUG Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Match these to the user + path you cloned into on the server:
User=ubuntu
WorkingDirectory=/home/ubuntu/pug-bot-tf2
# Runs the venv's python; DISCORD_TOKEN etc. are read from the .env file in
# WorkingDirectory by python-dotenv (so no secrets live in this unit file).
ExecStart=/home/ubuntu/pug-bot-tf2/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
